---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Citation from '../../components/Citation.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildBibTeX } from '../../lib/citation';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const citationHref = `/blog/${post.id}/citation.bib`;
const citationUrl = new URL(`/blog/${post.id}/`, Astro.site ?? Astro.url);
const bibtex = buildBibTeX({
  id: post.id,
  title: post.data.title,
  year: post.data.publishedAt.getUTCFullYear(),
  url: citationUrl.toString(),
  note: 'Research note',
});
const formatDate = (date: Date) => new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---

<BaseLayout
  title={`${post.data.title} - Duo Zhou`}
  description={post.data.description}
  active="blog"
  citationHref={citationHref}
>
  <article class="article-shell">
    <header class="article-header">
      <a class="back-link" href="/blog/">← All research notes</a>
      <p class="section-index">RESEARCH NOTE / {formatDate(post.data.publishedAt)}</p>
      <h1>{post.data.title}</h1>
      <p class="article-deck">{post.data.description}</p>
      <div class="tag-row">
        {post.data.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <Citation
      bibtex={bibtex}
      downloadHref={citationHref}
      filename={`${post.id}.bib`}
      label="Cite this note"
    />
  </article>
</BaseLayout>
